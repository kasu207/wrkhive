# Öffentliche URL der App (für OAuth-Redirects und Webhooks), ohne Slash am Ende
APP_URL=http://localhost:3000

# Verschlüsselt die Geräte-Tokens (mind. 32 Zeichen, z. B. `openssl rand -base64 48`).
# Leer lassen: Wrkhive erzeugt beim ersten Start ein Secret und speichert es
# neben der Datenbank (im Docker-Volume), so dass es Neustarts übersteht.
APP_SECRET=

# Pfad zur SQLite-Datenbank (Standard: ./data/wrkhive.db)
# DATABASE_PATH=/var/lib/wrkhive/wrkhive.db

# KI-Coach (Claude). Ohne Schlüssel arbeitet der Coach regelbasiert.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5

# Garmin Connect Developer Program (Training API + Activity API)
# Ohne Zugangsdaten startet die Garmin-Verbindung im Demo-Modus.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Geheimer Token, der an die Webhook-URL angehängt wird (…/api/webhooks/garmin?token=…)
GARMIN_WEBHOOK_TOKEN=

# Wahoo Cloud API
# Optional: Für eine private Installation lässt sich die (kostenlose, sofort
# nutzbare) persönliche Wahoo-App auch direkt in Wrkhive unter „Geräte →
# Wahoo einrichten“ hinterlegen. Werte hier haben Vorrang.
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
# Webhook-Token aus dem Wahoo-Developer-Portal
WAHOO_WEBHOOK_TOKEN=

# intervals.icu braucht keine Einträge: Jeder Nutzer verbindet sein eigenes
# Konto mit Athleten-ID und persönlichem API-Schlüssel unter „Geräte“.

# Absicherung für GET /api/cron/sync (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Hintergrund-Sync in Minuten (0 = aus). Holt neue Aktivitäten auch ohne Webhooks.
# SYNC_INTERVAL_MINUTES=30

# Optionaler Tunnel für Webhooks/OAuth (docker compose --profile tunnel up)
# Kostenlose statische Domain unter https://dashboard.ngrok.com/domains
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=dein-name.ngrok-free.app
# Mit Tunnel: APP_URL=https://dein-name.ngrok-free.app
