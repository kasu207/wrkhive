# Öffentliche URL der App (für OAuth-Redirects und Webhooks), ohne Slash am Ende
APP_URL=http://localhost:3000

# Pflicht in Produktion: mindestens 32 zufällige Zeichen (verschlüsselt Geräte-Tokens)
#   openssl rand -base64 48
APP_SECRET=

# Pfad zur SQLite-Datenbank (Standard: ./data/wrkhive.db)
# DATABASE_PATH=/var/lib/wrkhive/wrkhive.db

# KI-Coach (Claude). Ohne Schlüssel arbeitet der Coach regelbasiert.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5

# Garmin Connect Developer Program (Training API + Activity API)
# Ohne Zugangsdaten startet die Garmin-Verbindung im Demo-Modus.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Geheimer Token, der an die Webhook-URL angehängt wird (…/api/webhooks/garmin?token=…)
GARMIN_WEBHOOK_TOKEN=

# Wahoo Cloud API
# Ohne Zugangsdaten startet die Wahoo-Verbindung im Demo-Modus.
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
# Webhook-Token aus dem Wahoo-Developer-Portal
WAHOO_WEBHOOK_TOKEN=

# Absicherung für GET /api/cron/sync (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
