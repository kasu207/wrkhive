# Vorlage für den Produktivserver. Kopieren nach .env.production (im Projektordner)
# und ausfüllen:  cp deploy/env.production.example .env.production

# Domain, unter der Wrkhive erreichbar ist (DNS-A-Eintrag auf die Server-IP).
DOMAIN=wrkhive.example.de
# E-Mail für Let's Encrypt (Hinweise zu ablaufenden Zertifikaten).
ACME_EMAIL=du@example.de

# Verschlüsselt Geräte-Tokens und API-Schlüssel. Einmal erzeugen und NIE ändern:
#   openssl rand -base64 48
APP_SECRET=

# Registrierung: first = nur das erste Konto (du), danach geschlossen; closed; open
SIGNUP_MODE=first
# Demo-Konten mit Beispieldaten auf dem öffentlichen Server aus.
DEMO_ENABLED=false

# KI-Coach (optional). Ohne Schlüssel arbeitet der Coach regelbasiert.
ANTHROPIC_API_KEY=

# Wahoo direkt (optional, nach Freigabe deiner Wahoo-App). Alternativ in der
# App unter Geräte > Wahoo einrichten. Redirect URI im Wahoo-Portal:
#   https://<DOMAIN>/api/devices/wahoo/callback
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_WEBHOOK_TOKEN=

# Garmin direkt (optional, nur mit Freigabe im Garmin Connect Developer Program)
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_WEBHOOK_TOKEN=

# Hintergrund-Sync in Minuten
SYNC_INTERVAL_MINUTES=30
